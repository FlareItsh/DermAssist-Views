# Backend API endpoint (e.g., https://api.yourdomain.com/api on production / Laravel Cloud)
NUXT_PUBLIC_API_BASE=http://localhost:8000/api
NUXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Storage Base URL for uploaded images (e.g., https://api.yourdomain.com/storage or S3 bucket URL)
NUXT_PUBLIC_STORAGE_BASE=http://localhost:8000/storage

# Laravel Reverb WebSocket configuration
NUXT_PUBLIC_REVERB_KEY=k2sz1zlx9d0xc6plrtoy
NUXT_PUBLIC_REVERB_HOST=localhost
NUXT_PUBLIC_REVERB_PORT=8080
NUXT_PUBLIC_REVERB_SCHEME=http
